# ============================
# 1. 操作系统垃圾文件（必加）
# ============================
.DS_Store          # Mac 系统文件
Thumbs.db          # Windows 缩略图缓存

# ============================
# 2. IDE/编辑器配置（本地独享，别传）
# ============================
.idea/             # IntelliJ IDEA
.vscode/           # VS Code
*.iml              # IDEA 模块文件
*.swp              # Vim 临时交换文件
*~                 # 很多编辑器的备份文件

# ============================
# 3. 项目依赖（巨量文件，绝不能传）
# ============================
node_modules/      # 前端（Node.js）
vendor/            # PHP（Composer）
venv/              # Python 虚拟环境
.venv/
env/
__pycache__/       # Python 缓存
*.pyc

# ============================
# 4. 编译/构建产物（能自动生成的都不传）
# ============================
target/            # Java Maven 编译输出
build/             # 通用构建目录
dist/              # 打包后的文件
*.class            # Java 字节码
*.o                # C/C++ 目标文件
*.exe              # Windows 可执行文件

# ============================
# 5. 敏感信息和本地配置（打死也不能传）
# ============================
.env               # 环境变量（数据库密码、密钥）
.env.local
.secrets/
config.local.*     # 本地专属配置文件

# ============================
# 6. 日志和临时文件
# ============================
logs/
*.log
tmp/
temp/
*.tmp